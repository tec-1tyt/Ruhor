---
/**
 * Shared document shell: SEO head (title, description, canonical, hreflang, OG,
 * structured data), self-hosted fonts with per-language preload, header, footer.
 */
import { Font, fontData } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import { languages, t, paths, type Lang, type PageKey } from '../i18n';
import { company } from '../data/company';
import { serviceCategories } from '../data/services';

interface Props {
  lang: Lang;
  /** Which page this is — used for hreflang alternates and the language switcher. */
  page: PageKey | 'notFound';
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const d = t(lang);
const site = Astro.site!;

const hasAlternates = page !== 'notFound' && page !== 'thanks';
const canonical = page === 'notFound' ? null : new URL(paths[page as PageKey](lang), site).href;
const alternates = hasAlternates
  ? languages.map((l) => ({ hreflang: l.hreflang, href: new URL(paths[page as PageKey](l.code), site).href }))
  : [];

// Preload only the font subsets this language renders above the fold.
const geo = fontData['--font-geologica'] ?? [];
const SUBSET_INDEX = { latin: 0, 'latin-ext': 1, cyrillic: 2 } as const;
const preloadSubsets: (keyof typeof SUBSET_INDEX)[] =
  lang === 'uk' ? ['latin', 'cyrillic'] : lang === 'cs' ? ['latin', 'latin-ext'] : ['latin'];
const fontPreloads = preloadSubsets.map((s) => geo[SUBSET_INDEX[s]]?.src[0]?.url).filter(Boolean) as string[];

const ogImage = new URL('/og.jpg', site).href;

// Structured data (home page): GeneralContractor with real, verifiable fields only.
const jsonLd =
  page === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'GeneralContractor',
        '@id': new URL('/#company', site).href,
        name: company.legalName,
        alternateName: company.brand,
        url: new URL(paths.home(lang), site).href,
        logo: new URL('/icon-512.png', site).href,
        image: ogImage,
        description: d.meta.description,
        email: company.email,
        ...(company.phone ? { telephone: company.phone } : {}),
        address: {
          '@type': 'PostalAddress',
          ...(company.street ? { streetAddress: company.street } : {}),
          ...(company.postalCode ? { postalCode: company.postalCode } : {}),
          addressLocality: company.city,
          addressCountry: company.countryCode,
        },
        identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: company.ico },
        knowsLanguage: languages.map((l) => l.hreflang),
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: d.services.title,
          itemListElement: serviceCategories.map((c) => ({
            '@type': 'OfferCatalog',
            name: d.services.categories[c.id].title,
            itemListElement: c.items.map((id) => ({
              '@type': 'Offer',
              itemOffered: { '@type': 'Service', name: d.services.items[id].name, description: d.services.items[id].desc },
            })),
          })),
        },
        ...(company.social.length ? { sameAs: company.social.map((s) => s.url) } : {}),
      }
    : null;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />}

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Font cssVariable="--font-geologica" />
    <Font cssVariable="--font-plex-mono" />

    <meta name="theme-color" content="#131518" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RUHOR Company" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={d.meta.locale} />
    {
      languages
        .filter((l) => l.code !== lang)
        .map((l) => <meta property="og:locale:alternate" content={t(l.code).meta.locale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    {page === 'home' && <Dock lang={lang} />}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
