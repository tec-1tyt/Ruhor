---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Intro from '../../components/sections/Intro.astro';
import Services from '../../components/sections/Services.astro';
import Projects from '../../components/sections/Projects.astro';
import Transform from '../../components/sections/Transform.astro';
import Scale from '../../components/sections/Scale.astro';
import Process from '../../components/sections/Process.astro';
import About from '../../components/sections/About.astro';
import Map from '../../components/sections/Map.astro';
import Reviews from '../../components/sections/Reviews.astro';
import Contact from '../../components/sections/Contact.astro';
import { langCodes, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const d = t(lang);
---

<BaseLayout lang={lang} page="home" title={d.meta.title} description={d.meta.description}>
  <Hero lang={lang} />
  <Intro lang={lang} />
  <Services lang={lang} />
  <Projects lang={lang} />
  <Transform lang={lang} />
  <Process lang={lang} />
  <Scale lang={lang} />
  <About lang={lang} />
  <Map lang={lang} />
  <Reviews lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
