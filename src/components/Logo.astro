---
/**
 * RUHOR logo as inline SVG: brass rhombus with the R + the RUHOR wordmark (currentColor).
 * Colours come from CSS variables (--logo-d / --logo-r / --logo-s) so the logo adapts to the
 * light/dark section under the header. `data-logo-r` marks the first wordmark R (footer morph).
 */
import { R, GLYPHS, WORDMARK_LAYOUT, WORDMARK_SIZE } from '../brand/logo';

interface Props {
  variant?: 'full' | 'mark';
  /** Accessible name; omit when the logo sits inside a labelled link. */
  label?: string;
  class?: string;
  animate?: boolean;
}
const { variant = 'full', label, class: className, animate = false } = Astro.props;
const D = 64; // rhombus height in the logo's own units
const GAP = 14;
const full = variant === 'full';
const width = full ? D + GAP + WORDMARK_SIZE.width : D;
const k = D / 212;
const ox = D + GAP;
const oy = (D - 48) / 2;
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${D}`}
  width={width}
  height={D}
  fill="currentColor"
  {...label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' }}
  data-logo={animate ? 'intro' : undefined}
>
  <g transform={`scale(${k})`} data-diamond>
    <polygon points="106,0 212,106 106,212 0,106" style="fill:var(--logo-d)"></polygon>
    <polygon points="106,14 198,106 106,198 14,106" fill="none" style="stroke:var(--logo-r)" stroke-width="1.6" opacity="0.55"></polygon>
    <g transform="translate(76.4 67.6) scale(1.6)">
      <path d={R.strut} style="fill:var(--logo-s)"></path>
      <path d={R.arch} style="fill:var(--logo-r)"></path>
      <path d={R.pillar} style="fill:var(--logo-r)"></path>
    </g>
  </g>
  {
    full &&
      WORDMARK_LAYOUT.map(({ glyph, x }, i) =>
        glyph === 'R' ? (
          <g transform={`translate(${ox + x} ${oy})`} data-logo-r={i === 0 ? '' : undefined}>
            <path d={R.strut} data-part={i === 0 ? 'strut' : undefined}></path>
            <path d={R.arch} data-part={i === 0 ? 'arch' : undefined}></path>
            <path d={R.pillar} data-part={i === 0 ? 'pillar' : undefined}></path>
          </g>
        ) : (
          <path
            transform={`translate(${ox + x} ${oy})`}
            d={GLYPHS[glyph as keyof typeof GLYPHS]}
            fill-rule={glyph === 'O' ? 'evenodd' : undefined}
            data-letter
          ></path>
        ),
      )
  }
</svg>
