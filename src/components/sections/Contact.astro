---
/**
 * Contact: three direct ways to reach the company — call, WhatsApp, email — as large tap targets,
 * plus company details and a map link. No form (nothing to break, nothing to fill in).
 * A channel is only shown when its data exists in data/company.ts.
 */
import SectionLabel from '../SectionLabel.astro';
import ArchEdge from '../ArchEdge.astro';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
import { company, mailHref, telHref } from '../../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const digits = company.phone ? company.phone.replace(/\D/g, '') : null;
const waHref = digits && company.messengers.whatsapp ? `https://wa.me/${digits}?text=${encodeURIComponent(c.waText)}` : null;
const tgHref = company.messengers.telegram ? `https://t.me/${company.messengers.telegram}` : null;
const mailTo = `${mailHref}?subject=${encodeURIComponent(c.mailSubject)}&body=${encodeURIComponent(c.waText)}`;
// Gmail in the browser: opens a compose window with the company address already filled in
const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(company.email)}&su=${encodeURIComponent(c.mailSubject)}&body=${encodeURIComponent(c.waText)}`;

type Reach = { id: string; icon: 'phone' | 'chat' | 'mail'; label: string; value: string; href: string; external?: boolean };
const reach: Reach[] = [
  ...(telHref ? [{ id: 'call', icon: 'phone' as const, label: c.channels.call, value: company.phone!, href: telHref }] : []),
  ...(waHref ? [{ id: 'whatsapp', icon: 'chat' as const, label: c.channels.whatsapp, value: company.phone!, href: waHref, external: true }] : []),
  ...(tgHref ? [{ id: 'telegram', icon: 'chat' as const, label: d.dock.telegram, value: `@${company.messengers.telegram}`, href: tgHref, external: true }] : []),
  { id: 'email', icon: 'mail' as const, label: c.channels.email, value: company.email, href: mailTo },
];
---

<section class="section contact" id="contact" data-theme="dark" aria-labelledby="contact-title">
  <ArchEdge color="var(--color-stone)" />
  <div class="container contact__grid">
    <div>
      <SectionLabel index="09">{c.label}</SectionLabel>
      <h2 id="contact-title" class="t-h2" style="margin-block: clamp(20px, 2.4vw, 32px)" data-split>{c.title}</h2>
      <p class="t-lead" data-reveal>{c.lead}</p>
      <p class="contact__note" data-reveal>{c.note}</p>

      <dl class="direct" data-reveal>
        <div class="direct__row">
          <dt class="label">{c.direct.company}</dt>
          <dd>{company.legalName} · IČO {company.ico}</dd>
        </div>
      </dl>
    </div>

    <div>
    <ul class="reach" role="list">
      {
        reach.map((r) => (
          <li data-reveal>
            <a class="reach__item" href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener' } : {})} {...(r.id === 'email' ? { 'data-mail-web': gmailHref } : {})}>
              <span class="reach__icon"><Icon name={r.icon} /></span>
              <span class="reach__text">
                <span class="label">{r.label}{r.external && <span class="sr-only"> {d.a11y.newTab}</span>}</span>
                <span class="reach__value">{r.value}</span>
              </span>
              <Icon name="arrow" class="reach__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>
