---
/**
 * Contact: direct channels (email, phone when provided, map) + enquiry form.
 * The form works without JavaScript (native POST → /api/contact/ → thank-you page).
 * With JS: inline validation, async submit, success/error states, and a pre-filled
 * email fallback so a lead is never lost if delivery fails (lesson F-01).
 */
import SectionLabel from '../SectionLabel.astro';
import ArchEdge from '../ArchEdge.astro';
import Icon from '../Icon.astro';
import { t, fmt, paths, type Lang } from '../../i18n';
import { company, mailHref, telHref, mapUrl } from '../../data/company';
import { serviceCategories } from '../../data/services';
import { channels } from '../../data/channels';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const f = c.form;
const privacyLink = `<a class="link" href="${paths.privacy(lang)}">${f.privacyLink}</a>`;
---

<section class="section contact" id="contact" data-theme="dark" aria-labelledby="contact-title">
  <ArchEdge color="var(--color-plaster)" />
  <div class="container contact__grid">
    <div>
      <SectionLabel index="07">{c.label}</SectionLabel>
      <h2 id="contact-title" class="t-h2" style="margin-block: clamp(20px, 2.4vw, 32px)" data-split>{c.title}</h2>
      <p class="t-lead" data-reveal>{c.lead}</p>

      <dl class="direct" data-reveal>
        <div class="direct__row">
          <dt class="label">{c.direct.email}</dt>
          <dd><a class="link" href={mailHref}>{company.email}</a></dd>
        </div>
        {
          telHref && (
            <div class="direct__row">
              <dt class="label">{c.direct.phone}</dt>
              <dd><a class="link" href={telHref}>{company.phone}</a></dd>
            </div>
          )
        }
        {
          channels
            .filter((ch) => ch.id !== 'call')
            .map((ch) => (
              <div class="direct__row">
                <dt class="label">{d.dock[ch.id]}</dt>
                <dd>
                  <a class="link" href={ch.href} {...(ch.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {ch.id === 'telegram' ? `@${company.messengers.telegram}` : company.phone}
                    {ch.external && <span class="sr-only"> {d.a11y.newTab}</span>}
                  </a>
                </dd>
              </div>
            ))
        }
        <div class="direct__row">
          <dt class="label">{c.direct.location}</dt>
          <dd>
            <a href={mapUrl} target="_blank" rel="noopener" class="link">
              {c.direct.map}<span class="sr-only"> {d.a11y.newTab}</span>
            </a>
          </dd>
        </div>
        <div class="direct__row">
          <dt class="label">{c.direct.company}</dt>
          <dd>{company.legalName} · IČO {company.ico}</dd>
        </div>
      </dl>
    </div>

    <div data-reveal>
      <form
        class="form"
        action="/api/contact/"
        method="post"
        data-form
        data-lang={lang}
        data-email={company.email}
        data-subject={c.mailSubject}
        data-errors={JSON.stringify(c.errors)}
        data-sending={f.sending}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="ts" value="" data-ts />

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="f-name">{f.name}</label>
            <input
              class="field__control"
              id="f-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength="100"
              aria-describedby="f-name-err"
            />
            <p class="field__error" id="f-name-err" data-error-for="name"></p>
          </div>
          <div class="field">
            <label class="field__label" for="f-contact">{f.contact}</label>
            <input
              class="field__control"
              id="f-contact"
              name="contact"
              type="text"
              autocomplete="email"
              required
              maxlength="120"
              aria-describedby="f-contact-hint f-contact-err"
            />
            <p class="field__hint" id="f-contact-hint">{f.contactHint}</p>
            <p class="field__error" id="f-contact-err" data-error-for="contact"></p>
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="f-service">
            <span>{f.service}</span><small>{f.optional}</small>
          </label>
          <select class="field__control" id="f-service" name="service">
            <option value="">{f.serviceAny}</option>
            {
              serviceCategories.map((cat) => (
                <optgroup label={d.services.categories[cat.id].title}>
                  {cat.items.map((id) => <option value={id}>{d.services.items[id].name}</option>)}
                </optgroup>
              ))
            }
            <option value="other">{f.serviceOther}</option>
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="f-message">{f.message}</label>
          <textarea
            class="field__control"
            id="f-message"
            name="message"
            rows="5"
            required
            maxlength="3000"
            aria-describedby="f-message-hint f-message-err"></textarea>
          <p class="field__hint" id="f-message-hint">{f.messageHint}</p>
          <p class="field__error" id="f-message-err" data-error-for="message"></p>
        </div>

        <div class="form__hp" aria-hidden="true">
          <label for="f-website">{f.honeypot}</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form__status" role="alert" data-form-status></div>

        <button class="btn btn--block" type="submit" data-submit>
          <span class="btn__roll"><span>{f.submit}</span><span aria-hidden="true">{f.submit}</span></span>
          <Icon name="arrow" class="btn__icon" />
        </button>
        <p class="form__note" set:html={fmt(f.privacy, { link: privacyLink })} />
      </form>

      <div class="form__success" tabindex="-1" hidden data-form-success>
        <Icon name="check" />
        <h3 class="t-h3">{c.success.title}</h3>
        <p class="t-lead">{c.success.text}</p>
        <button class="link" type="button" data-form-again>{c.success.again}</button>
      </div>
    </div>
  </div>
</section>
