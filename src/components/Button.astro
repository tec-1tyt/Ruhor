---
/**
 * Link-button with rolling label on hover. The duplicate label is aria-hidden,
 * so screen readers announce the text once.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'sm';
  icon?: 'arrow' | 'plus' | null;
  magnetic?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', icon = 'arrow', magnetic = false, class: className, ...rest } = Astro.props;
const text = (await Astro.slots.render('default')).trim();
---

<a
  href={href}
  class:list={['btn', variant === 'ghost' && 'btn--ghost', size === 'sm' && 'btn--sm', className]}
  data-magnetic={magnetic ? '' : undefined}
  {...rest}
>
  <span class="btn__roll"><span set:html={text} /><span aria-hidden="true" set:html={text} /></span>
  {icon && <Icon name={icon} class="btn__icon" />}
</a>
