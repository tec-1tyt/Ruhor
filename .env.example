# Copy to `.env` for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production + Preview).

# Public site URL (canonical, hreflang, sitemap, Open Graph). Set once a custom domain is connected.
# If empty, Vercel's production domain is used automatically.
SITE_URL=

# Contact form delivery via Resend (https://resend.com). Without a key the form
# answers "not configured" and offers the visitor a pre-filled email instead.
RESEND_API_KEY=
# Where enquiries go (default: ruhor.company@seznam.cz)
CONTACT_TO_EMAIL=
# Sender. Default "RUHOR web <onboarding@resend.dev>" only delivers to the email of the
# Resend account owner — verify your own domain in Resend to send from e.g. web@ruhor.cz.
CONTACT_FROM_EMAIL=

# Local testing only: log enquiries in the terminal instead of sending. Ignored in production builds.
CONTACT_DRY_RUN=false
